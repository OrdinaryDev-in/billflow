# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — added in Phase 3
RESEND_API_KEY=
EMAIL_FROM="Billflow <no-reply@yourdomain.com>"

# Payments (Razorpay) — added in a later phase
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Scheduled job protection — random secret, sent as a bearer token by the cron trigger
CRON_SECRET=
